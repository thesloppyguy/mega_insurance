# Shared
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# LiveKit Cloud egress (required for recordings — local paths are rejected)
EGRESS_S3_ACCESS_KEY=
EGRESS_S3_SECRET=
EGRESS_S3_BUCKET=
EGRESS_S3_REGION=
# Optional: S3-compatible (R2/MinIO). Set FORCE_PATH_STYLE=true for those.
EGRESS_S3_ENDPOINT=
EGRESS_S3_FORCE_PATH_STYLE=false

# Next.js API (worker callbacks)
# Must be reachable by the LiveKit worker process.
API_PUBLIC_BASE_URL=http://127.0.0.1:3000/api
WORKER_API_KEY=dev-worker-key
ANAM_AVATAR_ID=
ANAM_AVATAR_NAME=Mavrik Interviewer

# Optional: override browser API base (defaults to same-origin /api)
# NEXT_PUBLIC_API_BASE_URL=/api

# Worker — Gemini Live (primary path)
GOOGLE_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_VOICE=Puck

# Optional / legacy pipeline + Meta Model API
# MODEL_API_KEY / META_API_KEY: Meta Muse STT + Meta LLM (use an LLM_ key, not LM_).
# When dispatch config.llm.provider=meta, the worker uses Meta chat completions
# (streaming + vision). Pick the chat model with MUSE_SPARK_MODEL / MUSE_WONDER_MODEL.
MODEL_API_KEY=
META_API_KEY=
ANAM_API_KEY=
INWORLD_API_KEY=
TTS_PROVIDER=google
TTS_MODEL=gemini-2.5-flash-preview-tts
TTS_VOICE=Kore
GOOGLE_LLM_MODEL=gemini-3.8-flash
MUSE_SPARK_MODEL=muse-spark-1.3
MUSE_WONDER_MODEL=muse-wonder-1.0
MUSE_SAM_MODEL=sam-3.1
# Pipeline vision (Meta LLM): sample user camera frames into ImageContent at this FPS.
# Default 1.0 — used when config.llm.provider=meta (or whenever VIDEO_SAMPLE_FPS is set).
VIDEO_SAMPLE_FPS=1.0
