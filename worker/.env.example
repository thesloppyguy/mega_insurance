# Shared
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# LiveKit Cloud egress (required for room composite recordings)
EGRESS_S3_ACCESS_KEY=
EGRESS_S3_SECRET=
EGRESS_S3_BUCKET=
EGRESS_S3_REGION=
# Optional: S3-compatible (R2/MinIO). Set FORCE_PATH_STYLE=true for those.
EGRESS_S3_ENDPOINT=
EGRESS_S3_FORCE_PATH_STYLE=false

# Next.js API (worker callbacks) — must be reachable by the LiveKit worker
API_PUBLIC_BASE_URL=http://127.0.0.1:3000/api
WORKER_API_KEY=dev-worker-key

# Optional: override browser API base (defaults to same-origin /api)
# NEXT_PUBLIC_API_BASE_URL=/api

# Cascaded voice pipeline
# STT: Meta Muse · LLM: Inworld Gemma · TTS: Inworld flash (+ WORD timestamps for OptiModel)
INWORLD_API_KEY=
INWORLD_TTS_VOICE=Aarav

# Meta Muse (STT uses MODEL_API_KEY / META_API_KEY; post-call report uses Wonder + SAM)
MODEL_API_KEY=
META_API_KEY=
MUSE_SPARK_MODEL=muse-spark-1.3
MUSE_WONDER_MODEL=muse-wonder-1.0
MUSE_SAM_MODEL=sam-3.1

# Optional MediaPipe delegate override (CPU default)
NEXT_PUBLIC_MEDIAPIPE_DELEGATE=CPU

GOOGLE_API_KEY=